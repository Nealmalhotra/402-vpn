REDIS_URL=redis://127.0.0.1:6379

# API
API_PORT=3000
DEFAULT_DNS=1.1.1.1
AUTO_SEED_REGIONS=true
DEFAULT_SESSION_MODE=proxy
MIN_CREATE_MINUTES=10
CREATE_RATE_LIMIT_PER_IP_PER_HOUR=10
SESSION_TOKEN_SECRET=replace-me-in-production
SESSION_TOKEN_TTL_SECONDS=86400
FETCH_TIMEOUT_MS=30000
FETCH_MAX_RESPONSE_BYTES=500000
FETCH_RATE_LIMIT_PER_SESSION_PER_MINUTE=60
ALLOW_INSECURE_HTTP_TARGETS=false
ALLOW_LOCAL_PROXY_FALLBACK=true
REGIONAL_PROXY_SHARED_SECRET=
REGIONAL_PROXY_REQUEST_TIMEOUT_MS=10000

# x402
X402_ENABLED=false
X402_FACILITATOR_URL=https://facilitator.x402.org
X402_NETWORK=eip155:8453
X402_PAY_TO=0xYourUSDCReceivingAddress

# Billing
BILLING_TICK_SECONDS=30

# Agent
AGENT_REGION=us-west
WG_INTERFACE=wg0
WG_BIN=wg
AGENT_DRY_RUN=true
